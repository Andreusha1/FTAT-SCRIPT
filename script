local function readSavedKey()
    if not KEYGATE_ENABLED then return "" end
    if type(isfile) == "function" and type(readfile) == "function" then
        local ok, exists = pcall(isfile, KEY_FILE)
        if ok and exists then
            local rok, content = pcall(readfile, KEY_FILE)
            if rok and type(content) == "string" then
                return content:match("^%s*(.-)%s*$") or ""
            end
        end
    end
    return ""
end
