local jerkState = {
    Track = nil,
    Anim = nil,
    Thread = nil,
    DiedConn = nil,
    Active = false,
}

local function isR15Character(character)
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return false end
    return humanoid.RigType == Enum.HumanoidRigType.R15
end

local function stopJerk()
    jerkState.Active = false
    if jerkState.Thread then
        pcall(task.cancel, jerkState.Thread)
        jerkState.Thread = nil
    end
    if jerkState.DiedConn then
        pcall(function() jerkState.DiedConn:Disconnect() end)
        jerkState.DiedConn = nil
    end
    if jerkState.Track then
        pcall(function()
            jerkState.Track:Stop()
            jerkState.Track:Destroy()
        end)
        jerkState.Track = nil
    end
    if jerkState.Anim then
        pcall(function() jerkState.Anim:Destroy() end)
        jerkState.Anim = nil
    end
end

local function startJerk()
    local character = localPlayer.Character
    if not character then
        LegacyUI:Notify({ Title = "Jerk", Content = "Character is not loaded.", Type = "Warning", Duration = 3 })
        return
    end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end
    stopJerk()
    local animator = humanoid:FindFirstChildOfClass("Animator")
    if not animator then
        animator = Instance.new("Animator")
        animator.Parent = humanoid
    end
    jerkState.Active = true
    jerkState.DiedConn = humanoid.Died:Connect(function()
        stopJerk()
    end)
    jerkState.Thread = task.spawn(function()
        while jerkState.Active do
            local r15 = isR15Character(character)
            if not jerkState.Track then
                local anim = Instance.new("Animation")
                anim.AnimationId = not r15 and "rbxassetid://72042024" or "rbxassetid://698251653"
                jerkState.Anim = anim
                local ok, loaded = pcall(function()
                    return animator:LoadAnimation(anim)
                end)
                if ok and loaded then
                    jerkState.Track = loaded
                else
                    break
                end
            end
            pcall(function()
                jerkState.Track:Play()
                jerkState.Track:AdjustSpeed(r15 and 0.7 or 0.65)
                jerkState.Track.TimePosition = 0.6
            end)
            task.wait(0.1)
            while jerkState.Active and jerkState.Track and jerkState.Track.TimePosition < (not r15 and 0.65 or 0.7) do
                task.wait(0.1)
            end
            if jerkState.Track then
                pcall(function() jerkState.Track:Stop() end)
                pcall(function() jerkState.Track:Destroy() end)
                jerkState.Track = nil
            end
            if jerkState.Anim then
                pcall(function() jerkState.Anim:Destroy() end)
                jerkState.Anim = nil
            end
            task.wait()
        end
    end)
    LegacyUI:Notify({ Title = "Jerk", Content = "Animation started", Type = "Info", Duration = 2 })
end

