}

local function getCharacterRoot(character)
    if not character then return nil end
    return character:FindFirstChild("HumanoidRootPart")
        or character:FindFirstChild("Torso")
        or character:FindFirstChild("UpperTorso")
end

local function isR15(character)
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return false end
    return humanoid.RigType == Enum.HumanoidRigType.R15
end

local function stopBang()
    if bangState.LoopConn then
        pcall(function() bangState.LoopConn:Disconnect() end)
        bangState.LoopConn = nil
    end
    if bangState.DiedConn then
        pcall(function() bangState.DiedConn:Disconnect() end)
        bangState.DiedConn = nil
    end
    if bangState.Track then        pcall(function()
            bangState.Track:Stop(0.15)
            bangState.Track:Destroy()
        end)
        bangState.Track = nil
    end
    if bangState.Anim then
        pcall(function() bangState.Anim:Destroy() end)
        bangState.Anim = nil
    end
end

local function playBang(targetPlayer, speed)
    local character = localPlayer.Character
    if not character then
        LegacyUI:Notify({ Title = "Bang", Content = "Character is not loaded.", Type = "Warning", Duration = 3 })
        return
    end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end
    stopBang()
    local animator = humanoid:FindFirstChildOfClass("Animator")
    if not animator then
        animator = Instance.new("Animator")
        animator.Parent = humanoid
    end
    local animId = isR15(character) and 5918726674 or 148840371
    local anim = Instance.new("Animation")
    anim.AnimationId = "rbxassetid://" .. animId
    bangState.Anim = anim
    local success, track = pcall(function()
        return animator:LoadAnimation(anim)
    end)
    if not success or not track then
        LegacyUI:Notify({ Title = "Bang", Content = "Failed to load the animation.", Type = "Warning", Duration = 3 })
        stopBang()
        return
    end
    bangState.Track = track
    local ok = pcall(function()
        track:Play(0.1, 1, 1)
        track:AdjustSpeed(speed or 3)
    end)
    if not ok then
        stopBang()
        return
    end
    bangState.DiedConn = humanoid.Died:Connect(function()
        stopBang()
    end)
    if targetPlayer and targetPlayer.Character then
        local targetRoot = getCharacterRoot(targetPlayer.Character)
        if targetRoot then
            local offset = CFrame.new(0, 0, 1.1)
            bangState.LoopConn = RunService.Stepped:Connect(function()
                pcall(function()
                    local myRoot = getCharacterRoot(character)
                    local tRoot = getCharacterRoot(targetPlayer.Character)
                    if myRoot and tRoot and bangState.Track and bangState.Track.IsPlaying then
                        myRoot.CFrame = tRoot.CFrame * offset
                    end
                end)
            end)
        end
    end
    LegacyUI:Notify({
        Title = "Bang",
        Content = targetPlayer and ("Active with: " .. targetPlayer.Name) or "Animation started",
        Type = "Info",
        Duration = 2,
    })
end

