local function killAuraTick()
    if not killAuraEnabled then return end
    local char = localPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hrp = char.HumanoidRootPart

    if killAuraShowRing and killAuraRingPart and killAuraRingPart.Parent then
        local base = hrp.Position + Vector3.new(0, -2.5, 0)
        killAuraRingPart.CFrame = CFrame.new(base) * CFrame.Angles(0, 0, math.rad(90))
    end

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= localPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
            local dist = (plr.Character.HumanoidRootPart.Position - hrp.Position).Magnitude
            if dist <= killAuraRadius then
                local targetHRP = plr.Character.HumanoidRootPart
                pcall(function() SetNetworkOwner:FireServer(targetHRP, targetHRP.CFrame) end)
                if not targetHRP:FindFirstChild("KillAuraVel") then
                    local bv = Instance.new("BodyVelocity")
                    bv.Name = "KillAuraVel"
                    bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                    bv.P = 100000
                    bv.Velocity = (targetHRP.Position - hrp.Position).Unit * killAuraPower + Vector3.new(0, 200, 0)
                    bv.Parent = targetHRP
                    Debris:AddItem(bv, 0.5)
                end
                pcall(function() Struggle:FireServer() end)
                killAuraImpactEffect(plr.Character)
            end
        end
    end
end

