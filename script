local adapterComponentCounter = 0
local function nextAdapterId(name)
    adapterComponentCounter += 1
    local slug = tostring(name or "control"):lower():gsub("[^%w]+", "-"):gsub("^-", ""):gsub("-$", "")
    if slug == "" then slug = "control" end
    return "venomx." .. adapterComponentCounter .. "." .. slug
end

